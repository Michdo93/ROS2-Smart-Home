# Kapitel 20: Kinect-Treiber als Dienst auf dem Raspberry Pi
#   sudo cp ros2-kinect.service /etc/systemd/system/ && sudo systemctl enable --now ros2-kinect
[Unit]
Description=ROS 2 Kinect v1 Treiber
After=network-online.target
Wants=network-online.target

[Service]
User=pi
EnvironmentFile=/etc/ros2/ros2-umgebung.conf
ExecStart=/bin/bash -c 'source /opt/ros/lyrical/setup.bash && \
  source /home/pi/ros2_ws/install/setup.bash && \
  exec ros2 launch kinect_v1_ros2 kinect_v1.launch.py'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
