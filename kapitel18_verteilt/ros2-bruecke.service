# Kapitel 18: openHAB-Brücke als Dienst (Rechner mit Token)
#   sudo cp ros2-bruecke.service /etc/systemd/system/ && sudo systemctl enable --now ros2-bruecke
[Unit]
Description=ROS 2 openHAB-Brücke
After=network-online.target
Wants=network-online.target

[Service]
User=pi
EnvironmentFile=/etc/ros2/ros2-umgebung.conf
EnvironmentFile=/etc/ros2/openhab-token.conf
ExecStart=/bin/bash -c 'source /opt/ros/lyrical/setup.bash && \
  source /home/pi/ros2_ws/install/setup.bash && \
  exec ros2 launch openhab_bridge bridge.launch.py params:=/etc/ros2/bruecke.yaml'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
